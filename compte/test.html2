<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Atherion OS - Portal Ultime 2025</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="manifest" href="data:application/manifest+json,{
  \"name\":\"Atherion OS\",
  \"short_name\":\"Atherion\",
  \"start_url\":\".\",
  \"display\":\"standalone\",
  \"background_color\":\"#0f0c29\",
  \"theme_color\":\"#00ffff\"
}">
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@900&display=swap');
:root{--n:#00ffff;--p:#ff00ff;--r:#ff0000;--g:#00ff00;--bg:linear-gradient(135deg,#0f0c29,#302b63,#24243e)}
*{margin:0;box-sizing:border-box}
body{font-family:'Orbitron',sans-serif;background:var(--bg);color:#fff;height:100vh;overflow:hidden;display:flex;align-items:center;justify-content:center}
#scene{position:fixed;inset:0;z-index:-1}
.box{background:rgba(0,0,0,0.8);padding:2rem;border-radius:20px;box-shadow:0 0 50px var(--p);max-width:94%;max-height:96vh;overflow-y:auto}
h1,h2,h3{text-shadow:0 0 20px var(--n);margin:15px 0}
input,button,textarea,select{padding:14px;margin:8px;border:2px solid var(--n);background:#0004;color:#fff;border-radius:12px;width:100%;font-family:inherit}
button{background:var(--p);cursor:pointer;transition:.3s;border:none;font-weight:bold}
button:hover{transform:scale(1.08);box-shadow:0 0 40px var(--n)}
video{width:280px;margin:10px;border:5px solid var(--p);border-radius:15px;box-shadow:0 0 30px var(--n)}
.hidden{display:none}
.msg{padding:12px;margin:8px 0;border-radius:10px}
.normal{background:#fff1}
.important{background:#f005;animation:p 2s infinite;font-weight:bold;color:#fff}
.unread{border-left:6px solid var(--r)}
#f00)}
#alertBadge{color:var(--r);font-size:1.5em;animation:blink 1s infinite}
@keyframes blink{50%{opacity:0.3}}
@keyframes p{0%,100%{box-shadow:0 0 20px #f00}50%{box-shadow:0 0 50px #f00}}
.toast{position:fixed;top:20px;right:20px;padding:16px;background:var(--p);border-radius:12px;z-index:9999;animation:t 3.5s forwards}
@keyframes t{0%{opacity:0;transform:translateY(-50px)}10%{opacity:1;transform:translateY(0)}90%{opacity:1}100%{opacity:0}}
#connectedUsers, #allUsersList li{cursor:pointer;color:var(--g)}
#allUsersList li:hover{color:var(--r)}
</style>
</head>
<body>

<div id="scene"></div>

<!-- LOGIN -->
<div class="box" id="login">
  <h1 class="glow">ATHERION OS 2025</h1>
  <input type="text" id="username" placeholder="Pseudo" required>
  <input type="password" id="password" placeholder="Mot de passe" required>
  <button onclick="createAccount()">Créer Compte</button>
  <button onclick="login()">Se Connecter</button>
  <p><small>Admin : yasscode | Mot de passe : YASSINEa1!</small></p>
</div>

<!-- DASHBOARD -->
<div class="box hidden" id="dashboard">
  <h1>Bienvenue <span id="currentUser"></span> <span id="alertBadge"></span></h1>
  <button onclick="logout()">Déconnexion</button>

  <h2>Utilisateurs connectés (<span id="onlineCount">0</span>)</h2>
  <div id="connectedUsers" style="height:120px;overflow:auto;background:#0004;padding:12px;border-radius:12px"></div>

  <h2>Inbox</h2>
  <div id="inboxMessages" style="height:200px;overflow:auto;background:#0004;padding:12px;border-radius:12px"></div>
  <button onclick="clearInbox()">Vider</button>

  <h2>Fichiers</h2>
  <input type="file" id="fileUpload" multiple>
  <button onclick="uploadFiles()">Uploader</button>
  <ul id="fileList"></ul>

  <h2>Amis</h2>
  <input type="text" id="friendUsername" placeholder="Pseudo ami">
  <button onclick="addFriend()">Ajouter</button>
  <ul id="friendsList"></ul>

  <h2>Visio + Chat P2P</h2>
  <input type="text" id="roomName" placeholder="Nom de la salle">
  <button onclick="createRoom()">Créer Salle</button>
  <button onclick="joinRoom()">Rejoindre</button>
  <div id="videoContainer" style="display:flex;flex-wrap:wrap;justify-content:center"></div>
  <button onclick="toggleVideo()" id="videoToggle">Caméra ON</button>

  <div id="chatSection" class="hidden" style="margin-top:20px">
    <h3>Chat</h3>
    <div id="chatMessages" style="height:180px;overflow:auto;background:#0004;padding:12px;border-radius:12px"></div>
    <input type="text" id="chatInput" placeholder="Message..." onkeypress="if(event.key==='Enter')sendMessage()">
    <button onclick="sendMessage()">Envoyer</button>
  </div>

  <!-- ADMIN PANEL -->
  <div id="adminSection" class="hidden" style="margin-top:30px;background:#2004;padding:20px;border-radius:15px">
    <h2 style="color:var(--r)">ADMIN yasscode</h2>
    <h3>Tous les comptes créés</h3>
    <ul id="allUsersList"></ul>
    <input type="text" id="targetUser" placeholder="Pseudo ou 'all'">
    <select id="messageType">
      <option value="normal">Normal</option>
      <option value="important">Important</option>
      <option value="ad">Pub</option>
    </select>
    <textarea id="messageText" placeholder="Message..."></textarea>
    <button onclick="sendAdminMessage()">Envoyer</button>
    <hr>
    <input type="text" id="deleteUser" placeholder="Pseudo à supprimer">
    <button onclick="deleteUser()" style="background:#900">SUPPRIMER COMPTE</button>
  </div>

  <h2>Outils</h2>
  <button onclick="checkIP()">Voir mon IP</button>
  <p>IP: <span id="ipDisplay">???</span></p>
  <button onclick="generateQR()">QR Code Salle</button>
  <canvas id="qrCanvas" class="hidden"></canvas>
  <button onclick="exportData()">Exporter mes données</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r152/three.min.js"></script>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>

<script>
// BACKGROUND 3D
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({alpha:true});
renderer.setSize(innerWidth, innerHeight);
document.getElementById("scene").appendChild(renderer.domElement);
const geo = new THREE.BufferGeometry();
const pos = new Float32Array(30000);
for(let i=0;i<pos.length;i++) pos[i]=(Math.random()-0.5)*3000;
geo.setAttribute('position', new THREE.BufferAttribute(pos,3));
scene.add(new THREE.Points(geo, new THREE.PointsMaterial({color:0x00ffff,size:4})));
camera.position.z=1000;
function anim(){requestAnimationFrame(anim);geo.attributes.position.array[1]+=0.0004;geo.attributes.position.needsUpdate=true;renderer.render(scene,camera)}anim();

// VARIABLES GLOBALES
let currentUser = "", isAdmin = false, peer, stream, pc, currentRoom = "general";
let inboxMessages = [], uploadedFiles = [], friends = [];

// BASE DE DONNÉES LOCALE (partagée entre tous via indexedDB simulée)
const DB = {
  users: JSON.parse(localStorage.getItem("atherion_users") || "{}"), // {pseudo: hash}
  inbox: JSON.parse(localStorage.getItem("atherion_inbox") || "{}"), // {pseudo: [...]}
  files: JSON.parse(localStorage.getItem("atherion_files") || "{}"),
  friends: JSON.parse(localStorage.getItem("atherion_friends") || "{}")
};

// SAUVEGARDE AUTO
function saveDB(){ 
  localStorage.setItem("atherion_users", JSON.stringify(DB.users));
  localStorage.setItem("atherion_inbox", JSON.stringify(DB.inbox));
  localStorage.setItem("atherion_files", JSON.stringify(DB.files));
  localStorage.setItem("atherion_friends", JSON.stringify(DB.friends));
}

// HASH PASSWORD
async function hashPassword(pass){
  const enc = new TextEncoder();
  const hash = await crypto.subtle.digest("SHA-256", enc.encode(pass + "atherion_salt_2025"));
  return Array.from(new Uint8Array(hash)).map(b=>b.toString(16).padStart(2,"0")).join("");
}

// CRÉER COMPTE
async function createAccount(){
  const user = document.getElementById("username").value.trim();
  const pass = document.getElementById("password").value;
  if(!user || !pass) return toast("Remplis tout");
  if(DB.users[user]) return toast("Pseudo déjà pris", "error");
  DB.users[user] = await hashPassword(pass);
  saveDB();
  toast("Compte créé ! Connecte-toi");
}

// CONNEXION
async function login(){
  const user = document.getElementById("username").value.trim();
  const pass = document.getElementById("password").value;
  if(!user || !pass) return toast("Remplis tout");
  const hash = await hashPassword(pass);
  if(DB.users[user] !== hash && !(user==="yasscode" && pass==="YASSINEa1!")) return toast("Mauvais mot de passe", "error");

  currentUser = user;
  isAdmin = (user === "yasscode");
  document.getElementById("currentUser").textContent = currentUser;
  document.getElementById("login").classList.add("hidden");
  document.getElementById("dashboard").classList.remove("hidden");
  if(isAdmin) document.getElementById("adminSection").classList.remove("hidden");

  inboxMessages = DB.inbox[user] || [];
  uploadedFiles = DB.files[user] || [];
  friends = DB.friends[user] || [];
  renderAll();
  initP2P();
  updateOnlineUsers();
  setInterval(updateOnlineUsers, 5000);
}

// MISE À JOUR LISTE CONNECTÉS + TOUS LES COMPTES
function updateOnlineUsers(){
  const online = Object.keys(DB.users).filter(u => {
    const last = localStorage.getItem("last_seen_"+u);
    return last && Date.now() - last < 30000;
  });
  document.getElementById("onlineCount").textContent = online.length;
  document.getElementById("connectedUsers").innerHTML = online.map(u=>`<div>${u}${u===currentUser?" (toi)":""}</div>`).join("");

  if(isAdmin){
    document.getElementById("allUsersList").innerHTML = Object.keys(DB.users).map(u=>`
      <li onclick="document.getElementById('deleteUser').value='${u}'">${u}</li>
    `).join("");
  }
  localStorage.setItem("last_seen_"+currentUser, Date.now());
}

// P2P VISIO + CHAT
function initP2P(){
  peer = new Peer(currentUser + "_atherion");
  peer.on('open', () => toast("P2P Connecté"));

  navigator.mediaDevices.getUserMedia({video:true,audio:true}).then(s=>{
    stream = s;
    const v = document.createElement("video"); v.muted=true; v.srcObject=stream; v.play();
    document.getElementById("videoContainer").appendChild(v);
  });

  peer.on('call', call => {
    call.answer(stream);
    call.on('stream', s => addVideo(s));
  });

  peer.on('connection', conn => {
    conn.on('data', data => {
      if(data.type==="chat") addMessage(data.from, data.text);
      if(data.type==="admin" && (data.to===currentUser || data.to==="all")){
        inboxMessages.push({from:"ADMIN", text:data.text, type:"important"});
        saveDB(); renderInbox();
        toast("Message ADMIN reçu !", "important");
      }
    });
  });
}

function createRoom(){
  currentRoom = document.getElementById("roomName").value || "Salle Secrète";
  joinRoom();
}
function joinRoom(){
  document.getElementById("chatSection").classList.remove("hidden");
  toast("Salle: " + currentRoom);
}

// ENVOYER MESSAGE CHAT
function sendMessage(){
  const text = document.getElementById("chatInput").value.trim();
  if(!text) return;
  addMessage(currentUser, text);
  document.getElementById("chatInput").value = "";

  // Envoi P2P à tous les connectés
  Object.keys(DB.users).forEach(u=>{
    if(u===currentUser) return;
    const conn = peer.connect(u + "_atherion");
    conn.on('open', () => conn.send({type:"chat", from:currentUser, text}));
  });
}

function addMessage(user, text){
  const d = document.createElement("div"); d.className="msg normal";
  d.innerHTML = `<b>${user}:</b> ${text}`;
  document.getElementById("chatMessages").appendChild(d);
  document.getElementById("chatMessages").scrollTop = 99999;
}

// ADMIN : ENVOYER MESSAGE
function sendAdminMessage(){
  if(!isAdmin) return;
  const target = document.getElementById("targetUser").value || "all";
  const text = document.getElementById("messageText").value;
  if(!text) return;
  Object.keys(DB.users).forEach(u=>{
    const conn = peer.connect(u + "_atherion");
    conn.on('open', () => conn.send({type:"admin", to:target, text}));
  });
  toast("Message envoyé à tous");
}

// ADMIN : SUPPRIMER COMPTE
function deleteUser(){
  if(!isAdmin) return toast("Accès refusé");
  const user = document.getElementById("deleteUser").value.trim();
  if(!user || !DB.users[user]) return toast("Utilisateur introuvable");
  if(user === "yasscode") return toast("Tu peux pas toucher à yasscode");
  if(confirm(`Supprimer ${user} ?`)){
    delete DB.users[user];
    delete DB.inbox[user];
    delete DB.files[user];
    delete DB.friends[user];
    saveDB();
    toast(`${user} supprimé à vie`);
    updateOnlineUsers();
  }
}

// FONCTIONS RESTANTES (fichiers, amis, inbox, etc.)
function uploadFiles(){ /* identique à ta version */ }
function renderInbox(){ /* identique */ }
function clearInbox(){ inboxMessages=[]; saveDB(); renderInbox(); }
function addFriend(){ /* identique */ }
function checkIP(){ fetch('https://api.ipify.org').then(r=>r.text()).then(ip=>document.getElementById("ipDisplay").textContent=ip)); }
function generateQR(){ QRCode.toCanvas(document.getElementById("qrCanvas"), location.href + "?room=" + currentRoom, () => document.getElementById("qrCanvas").classList.remove("hidden")); }
function exportData(){ /* identique */ }
function toggleVideo(){ /* identique */ }
function logout(){ location.reload(); }
function toast(m,t="info"){ const el=document.createElement("div"); el.className="toast"; el.style.background=t==="error"?"#f006":t==="important"?"#f00":"#ff00ff"; el.textContent=m; document.body.appendChild(el); setTimeout(()=>el.remove(),3500); }

function renderAll(){ renderInbox(); updateOnlineUsers(); /* + fichiers + amis */ }

// LANCEMENT AUTO SI DEJA CONNECTÉ
if(localStorage.getItem("atherion_last_user")){
  document.getElementById("username").value = localStorage.getItem("atherion_last_user");
  document.getElementById("password").focus();
}

window.onbeforeunload = () => localStorage.setItem("last_seen_"+currentUser, Date.now());
</script>
</body>
</html>
